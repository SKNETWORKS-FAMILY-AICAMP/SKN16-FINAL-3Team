flowchart TD
    NOW["Now<br/>안정화"] --> Q1["Q1<br/>챗봇 품질/모듈 통합"]
    Q1 --> Q2["Q2<br/>학습/시뮬레이션 고도화"]
    Q2 --> Q3["Q3<br/>알림/운영 자동화"]
    Q3 --> Q4["Q4<br/>성능/운영 최적화"]

    %% Now
    NOW --> NOW1["RAG 답변 품질 튜닝<br/>프롬프트/모델 설정 점검"]
    NOW --> NOW2["일정·학습·시뮬레이션 아키텍처 정리<br/>(그래프 완료)"]
    NOW --> NOW3["기본 대시보드 지표 점검"]

    %% Q1
    Q1 --> Q1_1["챗봇 의도 라우팅 안정화<br/>일정/학습/시뮬레이션 분기"]
    Q1 --> Q1_2["일정 알림봇 PoC<br/>채널 팬아웃 설계"]
    Q1 --> Q1_3["학습 맞춤 출제 로직 정합성 검증"]
    Q1 --> Q1_4["시뮬레이션 STT 재해석 품질 개선"]

    %% Q2
    Q2 --> Q2_1["시뮬레이션 평가서/버그리포트→RAG 개선 루프 실배포"]
